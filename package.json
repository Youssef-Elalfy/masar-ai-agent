{
  "name": "masar-ai-agent",
  "private": true,
  "version": "0.2.0",
  "description": "RAHHAL AI — standalone tool-using travel AI agent for a fictional demo company (not a tourism website).",
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "validate:seed": "node scripts/validate-seed.mjs",
    "chat": "node server/src/cli.ts",
    "db:migrate": "node server/src/db/migrate-cli.ts",
    "db:seed": "node server/src/db/seed-cli.ts",
    "db:check": "node server/src/db/check-cli.ts",
    "catalog:add": "node server/src/catalog/add-package-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\" scripts/fixtures.test.mjs",
    "check": "npm run typecheck && npm run typecheck:client && npm test",
    "live:smoke": "node server/src/eval/live-smoke.ts",
    "providers:check": "node server/src/eval/provider-check.ts",
    "research:check": "node server/src/eval/research-check.ts",
    "crm:list": "node server/src/crm/crm-list-cli.ts",
    "crm:check": "node server/src/eval/crm-check.ts",
    "voice:check": "node server/src/eval/voice-check.ts",
    "web": "node server/src/web/main.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p client/e2e/tsconfig.json",
    "e2e": "playwright test -c client/playwright.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/aref-ruqaa-ink": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
