# DO NOT put real keys in this file. Copy to .env locally; .env is gitignored. Never paste keys into chat or code.

# ── Free-tier only (default true): paid providers are ignored and models outside the verified
#    free-tier allowlist are refused (see FREE_TIER in server/src/config.ts).
FREE_TIER_ONLY=true

# Primary LLM: Google Gemini API free tier (key from https://aistudio.google.com/apikey, in a project WITHOUT billing).
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Client-side pacing per model; set at or below the limits shown at https://aistudio.google.com/rate-limit
GEMINI_RPM=8
GEMINI_RPD=200

# Secondary LLM + speech-to-text: Groq free plan (key from https://console.groq.com/keys). Not xAI Grok.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=25
GROQ_RPD=900

# Embeddings for semantic memory (1024 dims to match the schema). Uses GEMINI_API_KEY.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024

# Voice notes (M5): Groq Whisper. Uses GROQ_API_KEY.
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo

# CRM (M4): AES-256-GCM key for lead contact fields (32 random bytes, base64). Generate locally, never commit, never share:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored contact details unreadable; changing it does too. Without it, lead tools report "not configured".
PII_ENCRYPTION_KEY=

# Primary database: Supabase Postgres (the first migration enables pgvector and pg_trgm). Session pooler string incl. DB password. Server-side only.
DATABASE_URL=

# Paid providers: only used if FREE_TIER_ONLY=false (not needed for this project).
MODEL_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Worldwide offer search (M3): Tavily free "Researcher" plan, 1,000 credits/month, no credit card (https://app.tavily.com).
# Each research call = 2 basic searches = 2 credits; results cached 6 h. Without a key the agent says search is not connected.
TRAVEL_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Conversation context: summarize older turns when the transcript exceeds this estimate.
CONTEXT_MAX_TOKENS=24000
CONTEXT_KEEP_RECENT_TOKENS=8000

# Privacy & agent limits
AUDIT_LOG_REDACTION=true
MAX_AGENT_STEPS=8
# Whole-turn deadline (bounded). Free-tier research turns take ~100 s; use 180000 for heavy research demos.
AGENT_TIMEOUT_MS=150000
# Per model call before falling back to the next free-tier model (flash-lite needs ~21 s for the full agent prompt)
PROVIDER_CALL_TIMEOUT_MS=40000
# The primary model gets less, so an overloaded primary falls back quickly
PROVIDER_PRIMARY_TIMEOUT_MS=20000
TOOL_TIMEOUT_MS=10000

# Web console (M6): npm run web → http://127.0.0.1:8787
# Signs the anonymous per-browser owner cookie. Set a random value of 32+ characters so browser sessions survive restarts
# (without it a random per-process secret is used). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_SESSION_SECRET=
WEB_HOST=127.0.0.1
WEB_PORT=8787
# Extra host names the web server answers to (comma-separated), e.g. your domain behind a reverse proxy.
# Loopback names are always allowed; any other Host header is refused (DNS-rebinding protection).
WEB_ALLOWED_HOSTS=
